{
  "name": "booking-engine-new",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Themeable, standalone hotel booking engine (search bar, wizard, cart, loyalty auth) for Next.js apps.",
  "repository": "github:CIN-Project/booking-engine-new",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
